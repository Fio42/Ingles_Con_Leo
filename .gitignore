# Nunca subir archivos de configuracion con claves o contraseñas reales
.env
.env.*
*.key
*.pem
secrets.json
config.local.js

# Basura tipica del sistema operativo / editores
.DS_Store
Thumbs.db
*.log
node_modules/

# Carpeta temporal donde Claude deja archivos para que Leo los borre a mano
_to_delete/

# Site Health: JSON crudo de Lighthouse por corrida (pesado, es solo
# intermedio; lo que importa queda resumido en SITE_HEALTH_REPORT.md y
# tools/site-health/history.json, esos sí se suben).
tools/site-health/lighthouse-raw/
tools/site-health/reports/GLOSSARY_AUDIT_REPORT.json
tools/site-health/reports/GLOSSARY_AUDIT_REPORT.md
tools/site-health/reports/GSC_GLOSSARY_REPORT.json
tools/site-health/reports/GSC_GLOSSARY_REPORT.md
# Credenciales locales de Google Search Console. En CI usar únicamente
# GSC_SERVICE_ACCOUNT_JSON como secret, nunca un archivo del repositorio.
tools/site-health/gsc-service-account.json
.claude/

# Temporales locales del CLI de Supabase y de Python
supabase/.temp/
__pycache__/
*.pyc

# QA E2E: sesion autenticada local de la cuenta de prueba (NUNCA subir: usuario, contrasena, cookies, tokens, storageState)
tools/e2e/.auth/
*.storageState.json

# Temporales de generacion de audio (Kokoro/Edge TTS) y notas locales de Site Health
*.tmp*.mp3
tools/site-health/DEVLOG.txt
tools/.kokoro-models/

tools/leo-ai-eval/out/

# Indexador: ajustes solo de este PC (p.ej. tema de ntfy). La sesion de Google, la cola y el registro viven en %LOCALAPPDATA%\InglesConLeo\indexador, fuera del repo.
tools/indexador/config.local.json
